# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_MODE=false
# Optional trusted local artifact. Use `python -m app.ml.train_anomaly` after
# capturing real FIRMS data, or `python -m app.ml.bootstrap` for demo only.
ML_MODEL_PATH=
# Trusted real-FIRMS recurrence artifact (included with this prototype).
ML_CLASSIFIER_PATH=models/firms_recurrence.joblib

# --- Database (PostgreSQL + PostGIS) ---
# Use postgresql+psycopg2:// for SQLAlchemy.
# Replace USER, PASSWORD, HOST, PORT, DB with your real values.
# Example for docker setup:
# DATABASE_URL=postgresql+psycopg2://thermalwatch:thermalwatch@localhost:5432/thermalwatch
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB

# --- NASA FIRMS ---
# Register a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Do NOT commit your real key. Copy this file to .env and fill it in there.
FIRMS_MAP_KEY=YOUR_FIRMS_MAP_KEY_HERE
# Default sensor: VIIRS NOAA-20 NRT (good coverage, ~375m).
# Other options: MODIS_NRT, VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT
FIRMS_SATELLITE=VIIRS_NOAA20_NRT
# FIRMS Area API accepts world or west,south,east,north. India bounding box:
# (legacy IND is also mapped to this box by the client).
FIRMS_AREA=68,6.5,97.5,35.5
# FIRMS Area API supports 1-5 days per request.
FIRMS_DAYS=5
# Set to data/firms_latest_raw.csv to use a real FIRMS capture when PostGIS is
# unavailable. Fetch with `python -m app.ingestion.capture` before API startup.
FIRMS_SNAPSHOT_PATH=

# --- Processing ---
# Max distance (meters) between two detections to consider them the same event.
CLUSTER_DISTANCE_METERS=1000
# Max time (hours) between two detections to consider them the same event.
CLUSTER_TIME_HOURS=72
# Minimum detections within CLUSTER_TIME_HOURS to be a "persistent" source.
PERSISTENCE_MIN_DETECTIONS=3

# --- Blockchain (EVM Testnet Anchoring) ---
# Enable on-chain anchoring of SHA-256 evidence package hashes.
# Set to true only when a valid testnet account and contract are deployed.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia.publicnode.com
# Address of deployed ThermalWatchAnchor contract on Sepolia
BLOCKCHAIN_CONTRACT_ADDRESS=
# Testnet private key with faucet ETH (e.g. Sepolia). NEVER commit real keys.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
BLOCKCHAIN_EXPLORER_ADDRESS_URL=https://sepolia.etherscan.io/address/

